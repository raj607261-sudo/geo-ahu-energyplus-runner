EnergyManagementSystem:Program,
  ProductModel,
  IF WarmupFlag == 1,
    SET Present = 0,
    SET BatchNo = 0,
    SET LoadedDay = 0,
    SET WtLoss = 0,
  ENDIF,
  IF (WarmupFlag == 0) && ((DayOfMonth == 1) || (DayOfMonth == 7) || (DayOfMonth == 13) || (DayOfMonth == 19) || (DayOfMonth == 25)) && (Hour == 10) && (LoadedDay <> DayOfMonth),
    SET LoadedDay = DayOfMonth,
    SET Present = 1,
    SET BatchNo = BatchNo + 1,
    SET WtLoss = 0,
    SET T1 = 28.0,
    SET T2 = 28.0,
    SET T3 = 28.0,
    SET T4 = 28.0,
    SET T5 = 28.0,
    SET Age = 0,
  ENDIF,
  IF Present == 0,
    SET ProdSensAct = 0,
    SET ProdLatAct = 0,
    SET RespTot = 0,
    SET CoreT = Tair,
    SET SurfT = Tair,
    SET MeanT = Tair,
    RETURN,
  ENDIF,
  SET dt = ZoneTimeStep * 3600 / 4,
  SET Pa = Wair * Pb / (0.621945 + Wair),
  SET SumSens = 0,
  SET SumLat = 0,
  SET SumResp = 0,
  SET k = 0,
  WHILE k < 4,
    SET Ts = (T5 / 6.066512e-01 + Tair / 3.507547e+01) / (1 / 6.066512e-01 + 1 / 3.507547e+01),
    SET Psat = @PsatFnTemp Ts,
    SET VPD = 0.98 * Psat - Pa,
    IF VPD < 0,
      SET VPD = 0,
    ENDIF,
    SET Mtr = 1.400000e-10 * 8.711375e-02 * VPD,
    SET Hfg = @HfgAirFnWTdb Wair Ts,
    SET Qev = Mtr * Hfg,
    SET Qout = (T5 - Tair) / 3.568212e+01,
    SET Q1 = 5.973869e-07 * ((1.8 * T1 + 32) ^ 2.8045) * 6.969100e-04,
    SET Q2 = 5.973869e-07 * ((1.8 * T2 + 32) ^ 2.8045) * 4.878370e-03,
    SET Q3 = 5.973869e-07 * ((1.8 * T3 + 32) ^ 2.8045) * 1.324129e-02,
    SET Q4 = 5.973869e-07 * ((1.8 * T4 + 32) ^ 2.8045) * 2.578567e-02,
    SET Q5 = 5.973869e-07 * ((1.8 * T5 + 32) ^ 2.8045) * 4.251151e-02,
    SET D1 = (2.747323e-02 * (T2 - T1) + Q1) * dt / 2.773702e+00,
    SET D2 = (2.747323e-02 * (T1 - T2) + 1.373661e-01 * (T3 - T2) + Q2) * dt / 1.941591e+01,
    SET D3 = (1.373661e-01 * (T2 - T3) + 3.205210e-01 * (T4 - T3) + Q3) * dt / 5.270033e+01,
    SET D4 = (3.205210e-01 * (T3 - T4) + 5.769378e-01 * (T5 - T4) + Q4) * dt / 1.026270e+02,
    SET D5 = (5.769378e-01 * (T4 - T5) + Q5 + (0 - Qout) + (0 - Qev)) * dt / 1.691958e+02,
    SET T1 = T1 + D1,
    SET T2 = T2 + D2,
    SET T3 = T3 + D3,
    SET T4 = T4 + D4,
    SET T5 = T5 + D5,
    SET SumSens = SumSens + Qout * 3.443773e+04,
    SET SumLat = SumLat + Qev * 3.443773e+04,
    SET SumResp = SumResp + (Q1 + Q2 + Q3 + Q4 + Q5) * 3.443773e+04,
    SET WtLoss = WtLoss + Mtr * 3.443773e+04 * dt,
    SET k = k + 1,
  ENDWHILE,
  SET ProdSensAct = SumSens / 4,
  SET Age = Age + ZoneTimeStep * 3600,
  SET CrateQ = 0,
  IF Age < 14400,
    SET Xc = Age / 712.5000,
    SET Xc = 0 - Xc,
    SET CrateQ = @Exp Xc,
    SET CrateQ = CrateQ * 9600.0000,
  ENDIF,
  SET ProdSensAct = ProdSensAct + CrateQ,
  SET ProdLatAct = SumLat / 4,
  SET RespTot = SumResp / 4,
  SET CoreT = T1,
  SET SurfT = (T5 / 6.066512e-01 + Tair / 3.507547e+01) / (1 / 6.066512e-01 + 1 / 3.507547e+01),
  SET MeanT = (T1 * 6.969100e-04 + T2 * 4.878370e-03 + T3 * 1.324129e-02 + T4 * 2.578567e-02 + T5 * 4.251151e-02) / 8.711375e-02;

EnergyManagementSystem:Program,
  DoorInfiltration,
  SET Frac = 0,
  IF (Hour == 8) || (Hour == 18),
    SET Frac = 0.033,
  ENDIF,
  IF ((DayOfMonth == 1) || (DayOfMonth == 7) || (DayOfMonth == 13) || (DayOfMonth == 19) || (DayOfMonth == 25)) && ((Hour == 9) || (Hour == 10)),
    SET Frac = 0.5,
  ENDIF,
  SET RhoI = @RhoAirFnPbTdbW Pb Tair Wair,
  SET RhoO = @RhoAirFnPbTdbW Pb Tout Wout,
  SET Qdoor = 0,
  IF RhoI > RhoO,
    SET Qdoor = 0.221 * 1.8000 * ((1 - RhoO / RhoI) ^ 0.5) * ((9.81 * 2.000) ^ 0.5) * ((2 / (1 + ((RhoI / RhoO) ^ 0.333333))) ^ 1.5),
  ENDIF,
  SET DoorInfilAct = Qdoor * Frac * (1 - 0.8),
  SET DoorFracOut = Frac;

EnergyManagementSystem:ProgramCallingManager,
  Product and Door,
  BeginTimestepBeforePredictor,
  ProductModel,
  DoorInfiltration;

